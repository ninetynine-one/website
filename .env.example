# Webhook del panel de gestión que guarda los mensajes del formulario.
# Local: http://localhost:3000/api/leads
DASHBOARD_LEADS_URL=
# Igual a LEADS_WEBHOOK_SECRET en el panel.
DASHBOARD_LEADS_SECRET=

# Opcional: ID de medición de Google Analytics 4 (G-XXXXXXXXXX).
# Solo se carga en producción; en desarrollo no envía datos.
# PUBLIC_GA_ID=

# Opcional: Sentry. Sin DSN, Sentry no hace nada.
# PUBLIC_SENTRY_DSN se lee al compilar (navegador); SENTRY_DSN, al ejecutar (servidor).
# PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# Subida de source maps en el build. Sin token, el build no sube nada y no falla.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Activa /api/sentry-test (header x-sentry-test). Sin esta variable, la ruta da 404.
# SENTRY_TEST_TOKEN=
