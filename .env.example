# Clave de API de Resend (https://resend.com/api-keys)
RESEND_API_KEY=

# Correo que recibe los mensajes del formulario de contacto.
# Sin un dominio verificado en Resend, debe ser el correo de la cuenta de Resend.
CONTACT_TO_EMAIL=

# Opcional: ID de medición de Google Analytics 4 (G-XXXXXXXXXX).
# Solo se carga en producción; en desarrollo no envía datos.
# PUBLIC_GA_ID=

# Opcional: remitente. Solo cámbielo si verifica un dominio en Resend.
# CONTACT_FROM_EMAIL="Ninety Nine One <onboarding@resend.dev>"

# Opcional: Sentry. Sin DSN, Sentry no hace nada.
# PUBLIC_SENTRY_DSN se lee al compilar (navegador); SENTRY_DSN, al ejecutar (servidor).
# PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
# Subida de source maps en el build. Sin token, el build no sube nada y no falla.
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# Activa /api/sentry-test (header x-sentry-test). Sin esta variable, la ruta da 404.
# SENTRY_TEST_TOKEN=
