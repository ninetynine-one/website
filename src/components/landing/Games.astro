---
import { buttonVariants } from "@/components/ui/button"
import { site } from "@/data/site"
import { cn } from "@/lib/utils"
---

<section
  id="juegos"
  class="container-page scroll-mt-18 pb-18 md:pb-24 lg:pb-32"
>
  <div class="flex flex-col items-start gap-5 rounded-2xl bg-paper p-7 shadow-paper md:flex-row md:items-center md:justify-between md:gap-10 md:p-12">
    <div class="flex flex-col gap-3">
      <span class="inline-flex h-7.5 items-center self-start rounded-full bg-secondary px-3 text-[13px] font-semibold text-secondary-foreground">
        Producto propio
      </span>
      <h2 class="max-w-[20ch] text-3xl tracking-display text-balance md:text-4xl">
        Nuestros juegos, para jugar en el navegador.
      </h2>
      <p class="max-w-xl text-lg/7 text-body">
        Tres demos gratis, sin cuenta ni instalación. Pruébelas y díganos qué le
        parecen.
      </p>
    </div>
    <a
      href={site.games}
      class={cn(buttonVariants({ variant: "ink", size: "lg" }))}
    >
      Ir a los juegos <span aria-hidden="true">→</span>
    </a>
  </div>
</section>
