---
import ThemeImage from "./ThemeImage.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import symbol from "@/assets/logo/nno-symbol.svg"
import symbolDark from "@/assets/logo/nno-symbol-dark.svg"
---

<section
  id="inicio"
  class="container-page grid scroll-mt-16 items-center gap-14 pt-16 pb-16 md:pt-24 md:pb-20 lg:pt-32 lg:pb-28 lg:grid-cols-2"
>
  <div class="flex flex-col gap-7">
    <h1 class="text-5xl leading-none tracking-display md:text-6xl lg:text-7xl text-balance">
      Software hecho con cuidado, para cada persona que lo usa.
    </h1>
    <p class="max-w-xl text-xl/7.5 text-pretty text-body">
      Creamos aplicaciones, apps y videojuegos propios. También desarrollamos
      software a medida, integramos IA en sus procesos y asesoramos a empresas
      que quieren hacerlo bien.
    </p>
    <div class="flex flex-wrap gap-2.5">
      <a href="#proyectos" class={cn(buttonVariants({ size: "lg" }))}>
        Ver proyectos
      </a>
      <a
        href="#contacto"
        class={cn(buttonVariants({ size: "lg", variant: "secondary" }))}
      >
        Desarrollo a medida
      </a>
    </div>
  </div>

  <div class="flex flex-col gap-6 rounded-2xl border bg-card p-7 md:p-10 lg:p-14">
    <div class="flex items-center justify-center py-2 md:py-4 lg:py-6">
      <ThemeImage
        light={symbol}
        dark={symbolDark}
        alt=""
        loading="eager"
        class="aspect-square w-full max-w-xs"
      />
    </div>
    <p class="flex flex-wrap justify-between gap-3 text-sm text-muted-foreground">
      <span>Noventa y nueve en el grupo.</span>
      <span class="font-semibold text-link">Vamos a buscar a la una.</span>
    </p>
  </div>
</section>
