---
import ThemeImage from "./ThemeImage.astro"
import { buttonVariants } from "@/components/ui/button"
import { cn } from "@/lib/utils"
import symbol from "@/assets/logo/nno-symbol.svg"
import symbolDark from "@/assets/logo/nno-symbol-dark.svg"
---

<section
  id="inicio"
  class="container-page grid scroll-mt-16 items-center gap-14 pt-[clamp(64px,10vw,128px)] pb-[clamp(64px,8vw,112px)] lg:grid-cols-2"
>
  <div class="flex flex-col gap-7">
    <h1 class="text-[clamp(44px,6.4vw,80px)] leading-none tracking-[-0.025em] text-balance">
      Software hecho con cuidado, para cada persona que lo usa.
    </h1>
    <p class="max-w-[50ch] text-[19px] leading-[30px] text-pretty text-body">
      Creamos aplicaciones, apps y videojuegos propios. También desarrollamos
      software a medida y asesoramos a empresas que quieren hacerlo bien.
    </p>
    <div class="flex flex-wrap gap-2.5">
      <a href="#proyectos" class={cn(buttonVariants({ size: "lg" }))}>
        Ver proyectos
      </a>
      <a
        href="#contacto"
        class={cn(buttonVariants({ size: "lg", variant: "secondary" }))}
      >
        Desarrollo a medida
      </a>
    </div>
  </div>

  <div class="flex flex-col gap-6 rounded-2xl border bg-card p-[clamp(28px,5vw,56px)]">
    <div class="flex items-center justify-center py-[clamp(8px,2vw,24px)]">
      <ThemeImage
        light={symbol}
        dark={symbolDark}
        alt=""
        loading="eager"
        class="aspect-square w-full max-w-[340px]"
      />
    </div>
    <p class="flex flex-wrap justify-between gap-3 text-sm text-muted-foreground">
      <span>Noventa y nueve en el grupo.</span>
      <span class="font-semibold text-link">Vamos a buscar a la una.</span>
    </p>
  </div>
</section>
