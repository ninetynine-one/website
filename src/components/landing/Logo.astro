---
import { Image } from "astro:assets"
import type { ImageMetadata } from "astro"

interface Props {
  light: ImageMetadata
  dark: ImageMetadata
  alt: string
  class?: string
  loading?: "eager" | "lazy"
}

const { light, dark, alt, class: className, loading = "lazy" } = Astro.props
---

<Image
  src={light}
  alt={alt}
  loading={loading}
  class:list={[className, "dark:hidden"]}
/>
<Image
  src={dark}
  alt={alt}
  loading={loading}
  class:list={[className, "hidden dark:block"]}
/>
