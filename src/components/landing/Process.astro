---
import { billing, process } from "@/data/site"
---

<section id="como" class="scroll-mt-18 bg-background py-18 md:py-24 lg:py-32">
  <div class="container-page flex flex-col">
    <h2 class="max-w-[17ch] text-4xl tracking-display text-balance md:text-5xl">
      Así se ve trabajar con nosotros.
    </h2>
    <p class="mt-5 max-w-xl text-lg text-body">
      Decimos las cosas como son: lo que cuesta, lo que tarda y lo que no
      sabemos todavía.
    </p>
    <ol class="relative mt-12 grid gap-10 sm:grid-cols-2 md:mt-20 lg:grid-cols-4 lg:gap-6 lg:before:absolute lg:before:inset-x-3 lg:before:top-2.75 lg:before:h-1 lg:before:bg-[radial-gradient(circle,var(--border-strong)_1.6px,transparent_2px)] lg:before:bg-size-[10px_4px] lg:before:bg-repeat-x">
      {process.map((step) => (
        <li class="relative flex flex-col gap-3 pt-11">
          <span
            class:list={[
              "absolute top-0 left-0 size-6.5 rounded-full shadow-[0_0_0_6px_var(--background)]",
              step.highlight ? "bg-primary" : "bg-foreground",
            ]}
            aria-hidden="true"
          />
          <span class="font-mono text-[13px] text-muted-foreground">
            {step.when}
          </span>
          <h3 class="text-2xl/7">{step.title}</h3>
          <p class="text-body">{step.description}</p>
        </li>
      ))}
    </ol>
    <div class="mt-14 grid gap-6 rounded-xl bg-paper p-6 shadow-paper md:mt-20 md:grid-cols-2 md:p-8 lg:grid-cols-4">
      <h3 class="text-2xl">Cómo cobramos</h3>
      {billing.map((item) => (
        <div class="flex flex-col gap-1">
          <strong class="text-[15px] font-semibold">{item.title}</strong>
          <p class="text-sm/5.5 text-body">{item.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
