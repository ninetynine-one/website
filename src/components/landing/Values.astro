---
import { values } from "@/data/site"
---

<section
  id="valores"
  class="container-page scroll-mt-18 pb-18 md:pb-24 lg:pb-32"
>
  <div class="rounded-2xl bg-inverse px-6 py-10 text-inverse-foreground dark:bg-muted dark:text-foreground md:px-14 md:py-18 lg:px-20 lg:py-24">
    <h2 class="mb-8 max-w-[17ch] text-4xl tracking-display text-balance md:mb-14 md:text-5xl">
      La tecnología al servicio de las personas. No al revés.
    </h2>
    <ul>
      {values.map((value) => (
        <li class="grid gap-3 border-t border-current/15 py-7 md:grid-cols-[4fr_8fr] md:gap-6">
          <h3 class="text-3xl">{value.title}</h3>
          <p class="max-w-xl text-lg/7 opacity-75 md:text-xl/8">
            {value.description}
          </p>
        </li>
      ))}
    </ul>
  </div>
</section>
