---
import { ContactForm } from "./ContactForm"
import { projectTypes, site } from "@/data/site"
---

<section
  id="contacto"
  class="container-page grid scroll-mt-18 gap-14 pb-18 md:pb-24 lg:grid-cols-[5fr_6fr] lg:gap-24 lg:pb-32"
>
  <div class="flex flex-col items-start gap-6">
    <h2 class="max-w-[17ch] text-4xl tracking-display text-balance md:text-5xl">
      Cuéntenos qué quiere construir.
    </h2>
    <p class="max-w-md text-lg/7 text-body">
      Le respondemos en los próximos días, con una persona del equipo y no con
      una plantilla.
    </p>
  </div>

  <ContactForm client:visible email={site.email} projectTypes={projectTypes} />
</section>
