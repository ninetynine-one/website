---
import { CopyIcon } from "lucide-react"

import { ContactForm } from "./ContactForm"
import { buttonVariants } from "@/components/ui/button"
import { decisions, projectTypes, site, timelines } from "@/data/site"
import { cn } from "@/lib/utils"
---

<section
  id="contacto"
  class="container-page grid scroll-mt-18 gap-14 pb-18 md:pb-24 lg:grid-cols-[5fr_6fr] lg:gap-24 lg:pb-32"
>
  <div class="flex flex-col items-start gap-6">
    <h2 class="max-w-[17ch] text-4xl tracking-display text-balance md:text-5xl">
      Cuéntenos qué quiere construir.
    </h2>
    <p class="max-w-md text-lg/7 text-body">
      La primera llamada dura 30 minutos y no tiene costo. Leemos todo y le
      respondemos en los próximos días.
    </p>
    <a
      href={site.whatsapp}
      target="_blank"
      rel="noopener"
      data-whatsapp="contacto"
      class={cn(buttonVariants({ variant: "secondary", size: "lg" }))}
    >
      Escribir por WhatsApp
    </a>
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-body">
      O escríbanos a
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <button
        type="button"
        data-copy-email={site.email}
        class={cn(buttonVariants({ variant: "outline", size: "xs" }))}
      >
        <CopyIcon aria-hidden="true" />
        <span data-copy-label aria-live="polite">Copiar</span>
      </button>
    </p>
  </div>

  <ContactForm
    client:visible
    email={site.email}
    projectTypes={projectTypes}
    timelines={timelines}
    decisions={decisions}
  />
</section>

<script>
  // Copia el correo; si el navegador no deja, queda el enlace mailto al lado.
  document
    .querySelectorAll<HTMLButtonElement>("[data-copy-email]")
    .forEach((button) =>
      button.addEventListener("click", async () => {
        const label = button.querySelector("[data-copy-label]")
        try {
          await navigator.clipboard.writeText(button.dataset.copyEmail ?? "")
          if (label) label.textContent = "Copiado"
        } catch {
          if (label) label.textContent = "No se pudo copiar"
        }
        setTimeout(() => label && (label.textContent = "Copiar"), 2000)
      })
    )
</script>
