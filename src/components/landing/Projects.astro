---
import SectionHeading from "./SectionHeading.astro"
import ThemeImage from "./ThemeImage.astro"
import { Badge } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import { featuredProject as project } from "@/data/site"
import { cn } from "@/lib/utils"
import storiaLight from "@/assets/projects/storia-light.png"
import storiaDark from "@/assets/projects/storia-dark.png"
---

<section
  id="proyectos"
  class="container-page flex scroll-mt-16 flex-col gap-10 py-18 md:py-24 lg:py-28"
>
  <SectionHeading eyebrow="Proyectos" title="Lo que hemos hecho" />

  <article class="grid overflow-hidden rounded-2xl border bg-card lg:grid-cols-2">
    <div class="relative min-h-95 bg-durazno-100 dark:bg-muted">
      <ThemeImage
        light={storiaLight}
        dark={storiaDark}
        alt={`Página de inicio de ${project.name}`}
        widths={[640, 960, 1280, 1906]}
        sizes="(min-width: 1024px) 600px, 100vw"
        class="absolute inset-0 size-full object-cover object-top"
      />
    </div>
    <div class="flex flex-col justify-center gap-4.5 p-7 md:p-10 lg:p-12">
      <div class="flex flex-wrap gap-2">
        <Badge variant="secondary">Producto propio</Badge>
        <Badge variant="success">
          <span class="size-1.5 rounded-full bg-current" aria-hidden="true" />
          Inscripciones abiertas
        </Badge>
      </div>
      <h3 class="text-4xl tracking-display">{project.name}</h3>
      <p class="max-w-md text-lg text-body">
        {project.description}
      </p>
      <p class="text-sm text-muted-foreground">
        Un producto de ninety nine one.
      </p>
      <a
        href={project.url}
        target="_blank"
        rel="noopener"
        class={cn(buttonVariants({ variant: "outline" }), "self-start")}
      >
        Conocer {project.name} <span aria-hidden="true">→</span>
      </a>
    </div>
  </article>
</section>
