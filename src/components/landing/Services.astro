---
import { services } from "@/data/site"

const tabs = {
  primary: "bg-secondary text-secondary-foreground",
  accent: "bg-accent text-accent-foreground",
  success: "bg-success text-success-foreground",
}
---

<section
  id="hacemos"
  class="container-page flex scroll-mt-18 flex-col gap-12 py-18 md:gap-18 md:py-24 lg:py-32"
>
  <h2 class="max-w-[17ch] text-4xl tracking-display text-balance md:text-5xl">
    Tres servicios, el mismo oficio.
  </h2>
  <div class="grid gap-x-6 gap-y-10 lg:grid-cols-2">
    {services.map((service, index) => {
      const wide = index === services.length - 1
      return (
        <article
          class:list={[
            "relative rounded-xl bg-paper p-7 shadow-paper md:p-10 lg:p-12",
            wide &&
              "lg:col-span-2 lg:grid lg:grid-cols-[5fr_6fr] lg:items-start lg:gap-16",
          ]}
        >
          <span
            class:list={[
              "absolute -top-3.5 left-8 inline-flex h-7 items-center rounded-sm px-3.5 text-[13px] font-semibold",
              tabs[service.tone],
            ]}
          >
            {service.tab}
          </span>
          <div>
            <h3 class="text-3xl text-balance md:text-4xl/10.5">
              {service.title}
            </h3>
            <p class:list={["mt-3.5 text-lg/7 text-body", !wide && "mb-6"]}>
              {service.description}
            </p>
          </div>
          <dl class:list={["text-[15px]", wide && "mt-6 lg:mt-0"]}>
            {service.items.map((item) => (
              <div class="flex justify-between gap-4 border-t py-3.5">
                <dt class="font-semibold text-foreground">{item.label}</dt>
                <dd class="text-right text-muted-foreground">{item.detail}</dd>
              </div>
            ))}
          </dl>
        </article>
      )
    })}
  </div>
</section>
