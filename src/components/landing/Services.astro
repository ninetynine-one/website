---
import SectionHeading from "./SectionHeading.astro"
import {
  Card,
  CardContent,
  CardDescription,
  CardHeader,
  CardTitle,
} from "@/components/ui/card"
import { aiService, services } from "@/data/site"

const tones = {
  primary: { ring: "bg-secondary", dot: "bg-primary" },
  accent: { ring: "bg-accent", dot: "bg-accent-foreground" },
}
---

<section id="hacemos" class="scroll-mt-16 bg-muted py-18 md:py-24 lg:py-28">
  <div class="container-page flex flex-col gap-10">
    <SectionHeading
      eyebrow="Qué hacemos"
      title="Dos formas de trabajar, el mismo oficio"
      class="max-w-160"
    />
    <div class="grid gap-5 lg:grid-cols-2">
      {services.map((service) => (
        <Card className="gap-5 rounded-xl [--card-spacing:--spacing(7)] md:[--card-spacing:--spacing(10)]">
          <CardHeader className="gap-5">
            <div
              class:list={[
                "flex size-12 items-center justify-center rounded-full",
                tones[service.tone].ring,
              ]}
              aria-hidden="true"
            >
              <span
                class:list={["size-3 rounded-full", tones[service.tone].dot]}
              />
            </div>
            <CardTitle className="text-3xl">
              <h3>{service.title}</h3>
            </CardTitle>
          </CardHeader>
          <CardContent className="flex flex-col gap-5">
            <CardDescription className="text-base">
              {service.description}
            </CardDescription>
            <ul class="flex flex-col border-t">
              {service.items.map((item) => (
                <li class="flex justify-between gap-3 border-b py-3.5 text-sm last:border-b-0">
                  <span class="font-semibold">{item.label}</span>
                  <span class="text-right text-muted-foreground">
                    {item.detail}
                  </span>
                </li>
              ))}
            </ul>
          </CardContent>
        </Card>
      ))}
      <Card className="rounded-xl [--card-spacing:--spacing(7)] md:[--card-spacing:--spacing(10)] lg:col-span-2">
        <CardContent className="grid gap-6 md:grid-cols-2 md:gap-14">
          <div class="flex flex-col gap-4">
            <span class="inline-flex h-6.5 items-center self-start rounded-full bg-secondary px-2.5 text-xs font-semibold text-secondary-foreground">
              {aiService.badge}
            </span>
            <CardTitle className="text-3xl text-balance">
              <h3>{aiService.title}</h3>
            </CardTitle>
            <CardDescription className="text-base text-pretty">
              {aiService.description}
            </CardDescription>
          </div>
          <ul class="flex flex-col self-end border-t">
            {aiService.items.map((item) => (
              <li class="flex justify-between gap-3 border-b py-3.5 text-sm last:border-b-0">
                <span class="font-semibold">{item.label}</span>
                <span class="text-right text-muted-foreground">
                  {item.detail}
                </span>
              </li>
            ))}
          </ul>
        </CardContent>
      </Card>
    </div>
  </div>
</section>
