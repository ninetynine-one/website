---
import Logo from "./Logo.astro"
import { navLinks, site, socialLinks } from "@/data/site"
import lockup from "@/assets/logo/nno-lockup.svg"
import lockupDark from "@/assets/logo/nno-lockup-dark.svg"

const year = new Date().getFullYear()
const linkClass = "text-foreground no-underline hover:text-link"
---

<footer class="border-t">
  <div class="container-page grid items-start gap-8 py-12 sm:grid-cols-2 lg:grid-cols-4">
    <div class="flex flex-col gap-3.5">
      <Logo
        light={lockup}
        dark={lockupDark}
        alt={site.name}
        class="h-14 w-auto self-start"
      />
      <span class="text-sm text-muted-foreground">{site.location}</span>
    </div>
    <nav class="flex flex-col gap-2.5 text-[15px]" aria-label="Estudio">
      <strong class="text-[13px] font-semibold text-muted-foreground">
        Estudio
      </strong>
      {navLinks.map((link) => (
        <a href={link.href} class={linkClass}>
          {link.label}
        </a>
      ))}
    </nav>
    <nav class="flex flex-col gap-2.5 text-[15px]" aria-label="Redes">
      <strong class="text-[13px] font-semibold text-muted-foreground">
        En otros lugares
      </strong>
      {socialLinks.map((link) => (
        <a href={link.href} class={linkClass}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="flex flex-col gap-2.5 text-sm text-muted-foreground">
      <span>
        © {year} {site.legalName}
      </span>
      <a href="#" class="text-muted-foreground">
        Privacidad
      </a>
    </div>
  </div>
</footer>
