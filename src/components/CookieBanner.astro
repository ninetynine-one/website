---
import { buttonVariants } from "@/components/ui/button"
import {
  Card,
  CardContent,
  CardDescription,
  CardTitle,
} from "@/components/ui/card"
import { cn } from "@/lib/utils"
---

<div
  data-cookie-banner
  hidden
  class="fixed inset-x-4 bottom-4 z-50 sm:left-auto sm:max-w-sm"
>
  <Card
    role="dialog"
    aria-labelledby="cookie-banner-title"
    aria-describedby="cookie-banner-description"
    className="shadow-md"
  >
    <CardContent className="flex flex-col gap-4">
      <div class="flex flex-col gap-1">
        <CardTitle id="cookie-banner-title">
          ¿Podemos medir las visitas?
        </CardTitle>
        <CardDescription id="cookie-banner-description" className="text-sm">
          Usamos Google Analytics para saber cuántas personas visitan el sitio y
          cómo llegan. Deja cookies, así que solo lo activamos si usted acepta.
          Puede cambiar su decisión en el pie de página.{" "}
          <a href="/privacidad">Más detalles</a>.
        </CardDescription>
      </div>
      <div class="flex flex-wrap gap-2">
        {/* Mismo peso para ambas opciones: no empujamos hacia aceptar. */}
        <button
          type="button"
          data-cookie-choice="denied"
          class={cn(buttonVariants({ variant: "outline", size: "sm" }))}
        >
          No, gracias
        </button>
        <button
          type="button"
          data-cookie-choice="granted"
          class={cn(buttonVariants({ variant: "outline", size: "sm" }))}
        >
          Aceptar
        </button>
      </div>
    </CardContent>
  </Card>
</div>

<script>
  const KEY = "cookie-consent"
  const banner = document.querySelector<HTMLElement>("[data-cookie-banner]")

  const read = () => {
    try {
      return localStorage.getItem(KEY)
    } catch {
      return null
    }
  }

  if (banner) {
    if (!read()) banner.hidden = false

    banner
      .querySelectorAll<HTMLButtonElement>("[data-cookie-choice]")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const choice = button.dataset.cookieChoice
          try {
            localStorage.setItem(KEY, choice ?? "denied")
          } catch {}
          if (choice === "granted") window.loadAnalytics?.()
          else window.disableAnalytics?.()
          banner.hidden = true
        })
      })

    document.querySelectorAll("[data-cookie-preferences]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault()
        banner.hidden = false
        banner.querySelector<HTMLButtonElement>("[data-cookie-choice]")?.focus()
      })
    })
  }
</script>
