---
// Google Analytics 4. Se carga o se apaga según la categoría "Estadísticas"
// del panel de cookies (src/lib/consent.ts). Solo en producción y con
// PUBLIC_GA_ID, para no medir el desarrollo local.
---

<script>
  import { PUBLIC_GA_ID } from "astro:env/client"
  import { setupGoogleAnalytics } from "@/lib/analytics"

  if (import.meta.env.PROD && PUBLIC_GA_ID) setupGoogleAnalytics(PUBLIC_GA_ID)
</script>
